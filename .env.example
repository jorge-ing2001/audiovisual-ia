# audiovisual-ia — variables de entorno (Fase 1 / MVP)
# Sin ninguna clave de pago el sistema funciona con los defaults locales/gratuitos.
# Ver docs/LOCAL-FREE-STACK.md para el detalle de cada variable.

# --- Seleccion de backend por capacidad ---
# (AIV_IMAGE_BACKEND se define mas abajo, en la seccion "MOTOR DE GENERACION DE IMAGENES".)
AIV_LLM_BACKEND=ollama            # ollama | openai
AIV_TTS_BACKEND=kokoro            # kokoro | edge | elevenlabs | openai | recorded (voz propia grabada)
AIV_ASR_BACKEND=faster_whisper

# --- LLM local (Ollama) ---
AIV_OLLAMA_URL=http://localhost:11434
AIV_OLLAMA_MODEL=llama3.1:8b     # ya descargado por el usuario; alternativas: qwen3:8b, qwen2.5-coder:7b

# ====================================
# MOTOR DE GENERACION DE IMAGENES
# ====================================
# Backend activo de imagenes: stock (Pexels/Pixabay) | placeholder | sd_local | stability | openai
AIV_IMAGE_BACKEND=stock

# Claves de stock gratuitas (opcionales). DEJAR VACIAS en el repo: pon tu clave en tu .env local.
# Sin clave o sin red, el motor degrada automaticamente a placeholder.
AIV_PEXELS_API_KEY=
AIV_PIXABAY_API_KEY=

# Orden de busqueda entre proveedores de stock.
AIV_IMAGE_PROVIDER_ORDER=pixabay,pexels

# Comportamiento cuando no se encuentra contenido (o no hay clave/red): caer a placeholder.
AIV_IMAGE_FALLBACK=placeholder

# ====================================
# GENERACION LOCAL FUTURA (Stable Diffusion)
# ====================================
# Declarado pero NO implementado todavia (enchufable en una feature posterior).
AIV_SD_LOCAL_ENABLED=false
AIV_SD_LOCAL_BACKEND=comfyui
AIV_SD_LOCAL_URL=http://localhost:8188

# ====================================
# MOTOR AUDIOVISUAL
# ====================================
AIV_VIDEO_ENGINE=remotion
AIV_VIDEO_RENDER_ENGINE=ffmpeg

# --- Binarios externos ---
# En tu PC (ejecucion local) deja 'ffmpeg'/'ffprobe' si estan en el PATH, o pon la ruta completa.
# (Nota: en el sandbox de desarrollo viven en /projects/sandbox/.localbin, fuera del PATH.)
AIV_FFMPEG_BIN=ffmpeg
AIV_FFPROBE_BIN=ffprobe

# --- Reutilizacion de lemo-opuscar (voz/ASR/mux, codigo MIT) ---
AIV_LEMO_OPUSCAR_PATH=/projects/sandbox/lemo-opuscar
# Interprete de Python que ejecuta los scripts TTS de lemo-opuscar. Vacio = autodeteccion
# multiplataforma del venv de lemo (.venv/Scripts/python.exe en Windows, .venv/bin/python
# en macOS/Linux) y, si no existe, el interprete actual. Define una ruta aqui para forzarlo.
AIV_LEMO_PYTHON=

# --- Voz/Audio (motor 5) ---
# Voz por defecto de Kokoro (vacio = default del script: af_bella / zf_xiaoxiao para cmn).
AIV_TTS_VOICE=
# Voz por defecto de edge-tts (vacio = default del script: zh-CN-XiaoxiaoNeural).
AIV_EDGE_VOICE=
# HOME alternativo para la cache de espeak-ng de Kokoro cuando $HOME es de solo lectura.
# (Kokoro copia los datos de espeak-ng a ~/.cache; apunta esto a una ruta escribible y corta.)
AIV_TTS_CACHE_HOME=
# Modelo de faster-whisper para subtitulos (nombre de Hugging Face o ruta local) e idioma.
AIV_ASR_MODEL=base
AIV_ASR_LANGUAGE=
# Limpieza de voz (highpass/de-noise/de-esser/compresor) antes de masterizar a -14 LUFS.
# (Tecnica adaptada de voz.py MIT de JustCarlos30/skills-videos-cortos; ver NOTICE.)
AIV_VOICE_CLEANUP=true
# Recorte de silencios con re-mapeo de timings (tecnica adaptada de voz.py MIT).
# Desactivado por defecto para no alterar la alineacion voz/subtitulos sin pedirlo.
AIV_TRIM_SILENCE=false
AIV_TRIM_SILENCE_DB=-35.0         # umbral de silencio (dBFS)
AIV_TRIM_MIN_SILENCE=0.35         # duracion minima de silencio a recortar (s)

# ====================================
# MOTOR 3D / BLENDER (Fase 3)
# ====================================
# Proveedor de la capacidad "clip" (clip de video por escena): blender (local, default).
# Futuro de pago (stubs preservados, no implementados): veo | runway | kling.
AIV_CLIP_BACKEND=blender
# Ruta/nombre del binario de Blender 4.x (configurable, como AIV_FFMPEG_BIN).
# En TU PC: apunta a Blender 4.x (p. ej. /usr/bin/blender o C:\...\blender.exe) y
# verifica 'blender --version' >= 4.0.
# En el sandbox de desarrollo Blender NO esta instalado: el render 3D real NO esta
# disponible aqui (la logica pura si se testea; el render se salta con razon).
AIV_BLENDER_BIN=blender
# Motor de render de Blender: eevee (rapido, cabe en 4GB VRAM, MVP) | cycles (lento, opcional).
AIV_RENDER_ENGINE_3D=eevee
# Carpeta de assets 3D (personajes/sets/animaciones). Vacio = media/assets3d.
AIV_BLENDER_ASSETS_DIR=
# Muestras de render (EEVEE/Cycles); sube calidad a costa de tiempo.
AIV_BLENDER_SAMPLES=32
# Timeout (s) del subproceso de Blender por escena (el tiempo de render no es restriccion).
AIV_BLENDER_TIMEOUT_S=3600
# Default global de production_type para proyectos nuevos: 2d | 3d (override por proyecto en BD).
AIV_PRODUCTION_TYPE=2d

# --- Proveedores de pago (opcionales; solo si se activan arriba) ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
STABILITY_API_KEY=

# --- Almacenamiento ---
AIV_DATABASE_URL=sqlite:///./audiovisual.db
AIV_MEDIA_ROOT=./media

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
